# Copy to .env for local dev - never commit the real .env (see .gitignore).

# Required - no wildcard CORS default; the server refuses to start without this.
ALLOWED_ORIGIN=http://localhost:5173

# Optional - both providers fall back to their public/anonymous tier
# (lower rate limits, still functional) when unset.
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=

# Optional - defaults to 8080.
PORT=8080
